.menu-button {
    min-height: 46px;
    padding: 10px 16px;
    margin-bottom: 8px;
    background-color: var(--raised);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 7px;
    color: var(--paper);
    font-size: 18px;
    -unity-text-align: middle-center;
    white-space: normal;
}
.menu-button:hover { background-color: #384033; border-color: #8f947e; }
.menu-button:focus { border-color: var(--accent); background-color: #3a3d2c; }
.menu-button:active { background-color: #4a4d37; }
.menu-button:disabled { color: #929488; background-color: #262b24; border-color: #383e33; }
.primary { background-color: var(--accent); color: #20241c; border-color: var(--accent); -unity-font-style: bold; }
.primary:hover, .primary:focus { background-color: #edcf8a; color: #191d16; border-color: #fff0c7; }
.primary:active { background-color: #c5a666; }
.primary:disabled { background-color: #383d2e; color: #949887; border-color: #454b3d; }
.destructive { color: var(--danger); border-color: #785348; }
.destructive:hover, .destructive:focus { background-color: #4a3028; border-color: var(--danger); }
.quiet { background-color: transparent; color: var(--muted); }
.fov-slider { height: 34px; margin: 0 8px; flex-shrink: 0; }
.fov-slider .unity-base-slider__drag-container { flex-grow: 1; height: 34px; }
.fov-slider .unity-base-slider__tracker { position: absolute; left: 0; right: 0; top: 15px; height: 4px; background-color: #69715c; border-radius: 2px; }
.fov-slider .unity-base-slider__dragger { position: absolute; top: 4px; width: 18px; height: 26px; background-color: var(--accent); border-width: 1px; border-color: var(--accent); border-radius: 5px; }
.fov-slider:hover .unity-base-slider__dragger, .fov-slider:focus .unity-base-slider__dragger { background-color: #f5d997; border-color: #fff1c9; }
.fov-slider .unity-base-slider__dragger-border { display: none; }
.unity-scroller--vertical { width: 10px; margin-left: 8px; }
.unity-scroller--vertical .unity-slider { flex-grow: 1; }
.unity-scroller--vertical .unity-base-field__input { flex-grow: 1; }
.unity-scroller--vertical .unity-base-slider__drag-container { flex-grow: 1; width: 10px; }
.unity-scroller--vertical .unity-base-slider__tracker { position: absolute; left: 3px; top: 0; bottom: 0; width: 4px; background-color: #30372c; border-radius: 2px; }
.unity-scroller--vertical .unity-base-slider__dragger { position: absolute; left: 1px; width: 8px; min-height: 20px; background-color: #a6a88d; border-radius: 4px; }
.unity-scroller--vertical .unity-base-slider__dragger-border { display: none; }
.unity-scroller__low-button, .unity-scroller__high-button { display: none; }
